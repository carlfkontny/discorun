# Må matche Authorization Callback Domain på https://www.strava.com/settings/api
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
STRAVA_VERIFY_TOKEN=
STRAVA_CONNECT_PIN=
CRON_SECRET=
